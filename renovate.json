{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lasuillard-s/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Widen Python library runtime requirements without changing development or interpreter constraints",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "rangeStrategy": "widen"
    }
  ]
}
